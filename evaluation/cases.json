        {"table": "tb_blog_comments", "primaryKey": ["id"], "fields": ["id", "blog_id", "status"], "expectedSha256": "d25d3aeb95bd400d5418231557e257ebb8c467207dc7687d537f6fe1f0e7ac2f"},
        {"table": "tb_follow", "primaryKey": ["id"], "fields": ["id", "user_id", "follow_user_id"], "expectedSha256": "9d8d508ab0697f26165e64ff1b049679b2e4c99524a8c909803ee00562966cdf"},
        {"table": "tb_seckill_voucher", "primaryKey": ["voucher_id"], "fields": ["voucher_id", "stock", "begin_time", "end_time"], "expectedSha256": "12feaabf1fd820a32859b559c7c646f186a12543042e972af43b3c534ef0b4be"}
