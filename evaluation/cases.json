        {"assertionId": "category-count-ranks", "type": "entityCountRanks", "description": "分类名称、店铺数量和竞赛排名正确；其余八类必须全部并列第 3。", "entities": [
          {"name": "美食", "aliases": ["美食类"], "expectedCount": 9, "expectedRank": 1}, {"name": "KTV", "aliases": ["KTV类", "KTV 类"], "expectedCount": 5, "expectedRank": 2},
