    "name": "hmdp",
    "identifier": "mysql://localhost:3306/hmdp",
    "fingerprint": {
      "algorithm": "datapilot-canonical-row-v1",
      "description": "按主键升序读取显式字段；NULL 编码为 N，非 NULL 值按 invariant 文本转 UTF-8 后编码为 V<10位字节长度>:<小写十六进制>；字段以字段名=值编码并用 | 连接，行用 LF 连接，表名也以长度前缀 UTF-8 编码写入头部；整个规范文本使用无 BOM UTF-8 计算 SHA-256。",
      "tables": [
        {"table": "tb_shop", "primaryKey": ["id"], "fields": ["id", "name", "type_id", "avg_price", "sold", "comments", "score", "area"], "expectedSha256": "4c6f173497898e871aedf02579eac04773ea45adcc7aeccafe339b5639495db3"},
        {"table": "tb_shop_type", "primaryKey": ["id"], "fields": ["id", "name", "sort"], "expectedSha256": "54870e3f9db333a9964dc51e7401a623bee4abe7ae777652cb1852ff8e3bd03d"},
        {"table": "tb_voucher_order", "primaryKey": ["id"], "fields": ["id", "user_id", "voucher_id", "status", "create_time", "pay_time", "use_time", "refund_time"], "expectedSha256": "992379e7d542a505ca1a46fc7100dbb5e83de620f621f661609da8fda1e26f0c"},
        {"table": "tb_voucher", "primaryKey": ["id"], "fields": ["id", "shop_id", "title", "pay_value", "actual_value"], "expectedSha256": "d2897090213748178f423533bb05dc65a56fa528d00178f2f5e471c9c6458d50"},
        {"table": "tb_user", "primaryKey": ["id"], "fields": ["id", "nick_name"], "expectedSha256": "71d480f9e8cdbcbe72116149fb1d4441fae70628e476beb646db33c288c2a952"},
        {"table": "tb_user_info", "primaryKey": ["user_id"], "fields": ["user_id", "fans"], "expectedSha256": "a8a3d3b3f94ef5e664c09fe4ac992f4735f0201cf29c2e13e288ff2402eacda2"},
        {"table": "tb_sign", "primaryKey": ["id"], "fields": ["id", "user_id", "date"], "expectedSha256": "0046cc86e2531710227bcc2f93baeed2cc2d88d44ee9ae0bffad823bc7724895"},
