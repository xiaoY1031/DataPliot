          {"name": "亲子游乐", "aliases": ["亲子"], "metrics": [{"expected": 2, "valueType": "number", "absoluteTolerance": 0}]}, {"name": "酒吧", "aliases": [], "metrics": [{"expected": 2, "valueType": "number", "absoluteTolerance": 0}]},
          {"name": "轰趴馆", "aliases": ["轰趴"], "metrics": [{"expected": 2, "valueType": "number", "absoluteTolerance": 0}]}, {"name": "美睫·美甲", "aliases": ["美睫美甲", "美睫/美甲"], "metrics": [{"expected": 2, "valueType": "number", "absoluteTolerance": 0}]}
